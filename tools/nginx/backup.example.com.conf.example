# Replace backup.example.com with your own hostname before deploying.
server {
    listen 80;
    server_name backup.example.com;
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    server_name backup.example.com;
    ssl_certificate /etc/letsencrypt/live/backup.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/backup.example.com/privkey.pem;
    client_max_body_size 500m;
    client_body_timeout 600s;

    location /api/v1/ {
        proxy_pass http://127.0.0.1:8876;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;
        proxy_connect_timeout 5s;
        proxy_send_timeout 600s;
        proxy_read_timeout 600s;
        proxy_intercept_errors on;
        error_page 502 504 = @backup_unavailable;
    }

    location @backup_unavailable {
        default_type application/json;
        add_header Cache-Control "no-store" always;
        return 503 '{"code":"BACKEND_UNAVAILABLE","message":"Backup service unavailable","requestId":""}';
    }

    location / { return 404; }
}
